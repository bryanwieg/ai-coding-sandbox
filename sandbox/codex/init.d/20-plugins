#!/bin/sh
# Install the plugins declared in the image's manifest once Codex is signed in.
# Marketplaces are cloned from GitHub through the egress proxy; the manifest
# checksum is recorded only after every entry succeeds.
set -eu

plugin_manifest=/usr/local/share/codex/plugins.txt
state_dir="${CODEX_HOME:-$HOME/.codex}"
installed_hash_file="$state_dir/plugins.manifest.sha256"

if [ ! -s "$plugin_manifest" ]; then
    exit 0
fi

manifest_hash=$(sha256sum "$plugin_manifest" | cut -d ' ' -f 1)
installed_hash=$(sed -n '1p' "$installed_hash_file" 2>/dev/null || true)

if [ "$manifest_hash" = "$installed_hash" ]; then
    exit 0
fi

if [ ! -f "$state_dir/auth.json" ]; then
    echo 'Codex plugins will be installed after login on the next launch.' >&2
    exit 0
fi

failed=false
while IFS= read -r entry; do
    case "$entry" in
        ''|'#'*) continue ;;
        'marketplace '*)
            source=${entry#marketplace }
            if ! printf '%s\n' "$source" | grep -Eq '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$'; then
                echo "Invalid Codex marketplace: $source" >&2
                exit 1
            fi
            if ! codex plugin marketplace add "$source" >/dev/null; then
                echo "Unable to add Codex marketplace: $source" >&2
                failed=true
            fi
            ;;
        *)
            if ! printf '%s\n' "$entry" | grep -Eq '^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+$'; then
                echo "Invalid Codex plugin selector: $entry" >&2
                exit 1
            fi
            if ! codex plugin add "$entry"; then
                echo "Unable to install Codex plugin: $entry" >&2
                failed=true
            fi
            ;;
    esac
done < "$plugin_manifest"

if [ "$failed" = false ]; then
    printf '%s\n' "$manifest_hash" > "$installed_hash_file"
else
    echo 'Plugin synchronization incomplete; it will be retried next launch.' >&2
fi
