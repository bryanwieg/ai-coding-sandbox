#!/bin/sh
set -eu
# Sessions (SANDBOX_SESSION=1) get the sandbox's guide and rules, from the
# image, as developer instructions on every launch.
if [ "${SANDBOX_SESSION:-}" = 1 ]; then
    set -- -c "developer_instructions=$(jq -Rs . /usr/local/share/sandbox/session-instructions.md)" "$@"
fi
# Hooks from installed plugins and configuration run without Codex's per-hook
# trust review, like Claude's, since the container is the boundary.
exec codex -a never --sandbox danger-full-access --dangerously-bypass-hook-trust "$@"
