#!/bin/sh
# Static checks of the session Compose file, its dev overlay, the base egress
# policy, the plugin manifests and the scripts. Needs Docker Compose and jq;
# starts nothing.
set -eu

root_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
check_dir=$(mktemp -d)
trap 'rm -rf "$check_dir"' EXIT HUP INT TERM
mkdir -p "$check_dir/src/project"

# Every session service is read-only with all capabilities dropped, adds only
# its documented ones, and keeps no-new-privileges except the daemon, which
# has only the rootless daemon's exceptions. Only the proxy reaches the uplink,
# the daemon alone joins its own network (internal unless direct egress is
# chosen), only the forwarder publishes ports, key files reach only the ssh services, and agents get the
# reference root and .sandbox read-only, with only the project and their own
# state writable. Released images come from GHCR, never a build.
session_file="$root_dir/compose.session.yaml"
dev_file="$root_dir/compose.dev.yaml"
render_session() (
    # Compose versions differ in whether they honor an inherited PWD.
    cd "$check_dir/src/project"
    env SANDBOX_UID=1000 SANDBOX_GID=1000 SANDBOX_DAEMON_EGRESS="${check_daemon_egress-}" \
        SANDBOX_REFERENCE="${check_reference-$check_dir}" \
        SANDBOX_PUBLISH_PORTS=8000-8001 SANDBOX_SSH_KEY_DIR=/tmp/sandbox-check-keys \
        docker compose -p sandbox-check "$@" --profile '*' config --format json
)
rendered_session=$(render_session -f "$session_file")
printf '%s\n' "$rendered_session" | jq -e --arg reference "$check_dir" '
    def root: test("^(0(:|$)|root(:|$))");
    def caps($name):
        if ($name | test("-state-init$|^migrate-")) then ["CHOWN", "DAC_OVERRIDE", "FOWNER"]
        elif $name == "docker" then ["SETGID", "SETUID"]
        else [] end;
    def nets: (.networks // {}) | keys;
    def writable: [ (.volumes // [])[] | select(.read_only != true) ];
    .services as $s |
    (($s | keys) == ["claude", "claude-state-init", "codex", "codex-state-init", "docker",
        "egress-proxy", "migrate-claude-state", "migrate-codex-state", "publish",
        "ssh-agent", "ssh-unlock", "trust"]) and
    all($s | to_entries[]; .key as $name | .value |
        (.read_only == true) and
        (.cap_drop == ["ALL"]) and
        (((.cap_add // []) | sort) == caps($name)) and
        ((.privileged // false) == false) and
        (.network_mode != "host") and
        (.build == null) and
        (.image | startswith("ghcr.io/bryanwieg/ai-coding-sandbox:")) and
        ([ (.volumes // [])[] | select(((.source // "") + " " + .target) | test("docker\\.sock")) ] | length == 0) and
        (if $name == "docker" then true
         else (.security_opt | index("no-new-privileges:true") != null) end) and
        (if (.user | root) then ($name | test("-state-init$|^migrate-|^trust$")) else true end) and
        (if ($name | test("-state-init$|^migrate-|^trust$|^ssh-")) then .network_mode == "none" else true end) and
        (if $name == "publish" then true else ((.ports // []) | length == 0) end) and
        (if ([ (.volumes // [])[] | select(.target == "/keys") ] | length > 0)
         then ($name | test("^ssh-")) and all(.volumes[] | select(.target == "/keys"); .read_only == true)
         else true end)) and
    ($s.docker as $d |
        (($d.security_opt | sort) == ["label=disable", "seccomp=unconfined", "systempaths=unconfined"]) and
        ([ $d.devices[] | .source ] == ["/dev/net/tun"]) and
        ($d.pids_limit > 0) and ($d.mem_limit != null) and
        (($d | nets) == ["session-daemon-proxied", "session-internal"]) and
        ($d.environment.HTTPS_PROXY == "http://egress-proxy:3128") and
        ([ $d.volumes[] | select(.type == "bind") | [.target, (.read_only == true)] ] ==
            [["/workspace/sandbox-check", false], ["/workspace/sandbox-check/.sandbox", true]])) and
    (($s["egress-proxy"] | nets) == ["session-internal", "session-uplink"]) and
    (($s.publish | nets) == ["session-internal", "session-publish"]) and
    # The unset slots leave one loopback placeholder with a random host port.
    ([ $s.publish.ports[] | [.host_ip, .published, .target] ] ==
        [["127.0.0.1", "8000", 8000], ["127.0.0.1", "8001", 8001], ["127.0.0.1", null, 9]]) and
    ([ $s | to_entries[] | select(.value.networks // {} | has("session-uplink")) | .key ] == ["egress-proxy"]) and
    ([ $s | to_entries[] | select(.value.networks // {} | has("session-publish")) | .key ] == ["publish"]) and
    ([ $s | to_entries[] | select(.value.networks // {} | keys | any(startswith("session-daemon-"))) | .key ] == ["docker"]) and
    (.networks["session-internal"].internal == true) and
    (.networks["session-daemon-proxied"].internal == true) and
    ((.networks["session-publish"].internal // false) == false) and
    (.networks["session-publish"].driver_opts["com.docker.network.bridge.enable_ip_masquerade"] == "false") and
    all(.volumes | to_entries[] | select(.key | test("state$|^trust$")); .value.external == true) and
    # Compose names the cache volume per project; it is never shared.
    ((.volumes.cache.external // false) == false) and
    (.volumes.cache.name == "sandbox-check_cache") and
    all(["claude", "codex"][]; . as $name | $s[$name] |
        (.environment.CLAUDE_CONFIG_DIR // .environment.CODEX_HOME) as $state |
        ((.user | root) | not) and
        ((. | nets) == ["session-internal"]) and
        (.working_dir == "/workspace/sandbox-check") and
        (.hostname == "sandbox") and
        (.environment.SANDBOX_SESSION == "1") and
        (.environment.HTTPS_PROXY == "http://egress-proxy:3128") and
        (.environment.SSH_AUTH_SOCK == "/run/ssh-agent/agent.sock") and
        ([ .volumes[] | select(.target == "/reference" and .source == $reference and .read_only == true) ] | length == 1) and
        ([ .volumes[] | select(.target == "/workspace/sandbox-check/.sandbox" and .read_only == true) ] | length == 1) and
        ([ writable[] | [.type, .target] ] | sort ==
            ([["bind", "/workspace/sandbox-check"], ["volume", $state], ["volume", "/cache"]] | sort)) and
        ([ .volumes[] | select(.target == "/cache") | .source ] == ["cache"]) and
        ([ .volumes[] | select(.source == "docker-certs") | [.read_only, .volume.subpath] ] == [[true, "client"]]) and
        (.depends_on["egress-proxy"].condition == "service_healthy") and
        (.depends_on["\($name)-state-init"].condition == "service_completed_successfully") and
        ([ $s["\($name)-state-init"].volumes[] | [.type, .source, .target] ] | sort ==
            ([["volume", "\($name)-state", $state], ["volume", "docker-certs", "/certs"],
              ["volume", "cache", "/cache"]] | sort)))
' >/dev/null

# Direct daemon egress gives the daemon alone its own uplink: agents stay
# internal and keep the proxy, and no other service joins that network. Extra
# and UDP slots publish on the chosen address; unset slots collapse to one
# loopback placeholder. Any other egress value names no network.
check_daemon_egress=direct SANDBOX_PUBLISH_ADDRESS=0.0.0.0 SANDBOX_PUBLISH_PORTS_3=27020 \
    SANDBOX_PUBLISH_UDP_PORTS=7777-7778 render_session -f "$session_file" | jq -e '
    .services as $s |
    (($s.docker.networks | keys) == ["session-daemon-direct", "session-internal"]) and
    ((.networks["session-daemon-direct"].internal // false) == false) and
    ([ $s | to_entries[] | select(.value.networks // {} | has("session-daemon-direct")) | .key ] == ["docker"]) and
    all(["claude", "codex"][]; $s[.] |
        ((.networks | keys) == ["session-internal"]) and
        (.environment.SANDBOX_DAEMON_EGRESS == "direct") and
        (.environment.HTTPS_PROXY == "http://egress-proxy:3128")) and
    ([ $s.publish.ports[] | [.host_ip, (.published // ""), .target, .protocol] ] | sort ==
        ([["0.0.0.0", "8000", 8000, "tcp"], ["0.0.0.0", "8001", 8001, "tcp"],
          ["0.0.0.0", "27020", 27020, "tcp"], ["127.0.0.1", "", 9, "tcp"],
          ["0.0.0.0", "7777", 7777, "udp"], ["0.0.0.0", "7778", 7778, "udp"]] | sort))
' >/dev/null
for egress in uplink publish internal bogus; do
    if check_daemon_egress=$egress render_session -f "$session_file" >/dev/null 2>&1; then
        echo "SANDBOX_DAEMON_EGRESS=$egress was accepted" >&2
        exit 1
    fi
done

# The daemon wipes its data unless SANDBOX_DOCKER_DATA=persistent reaches it;
# agents see the same value. The daemon itself refuses any other value.
for data in ephemeral persistent; do
    value=$data
    [ "$data" = persistent ] || value=
    SANDBOX_DOCKER_DATA=$value render_session -f "$session_file" | jq -e --arg data "$data" '
        all([.services.docker, .services.claude, .services.codex][];
            .environment.SANDBOX_DOCKER_DATA == $data)
    ' >/dev/null
done

# With references omitted, neither agent gains access to another host folder.
check_reference='' render_session -f "$session_file" | jq -e --arg project "$check_dir/src/project" '
    all([.services.claude, .services.codex][];
        .working_dir == "/workspace/sandbox-check" and
        .environment.SANDBOX_REFERENCE == "" and
        ([.volumes[] | select(.target == "/reference") |
            [.type, .source, .read_only]] == [["bind", "/dev/null", true]]) and
        ([.volumes[] | select(.target == "/workspace/sandbox-check") |
            [.type, .source, (.read_only // false)]] ==
            [["bind", $project, false]]))
' >/dev/null

# The dev overlay changes only how images are obtained.
strip_images='del(.services[] | .build, .image, .pull_policy) | with_entries(select(.key | startswith("x-") | not))'
if [ "$(printf '%s\n' "$rendered_session" | jq -S "$strip_images")" != \
    "$(render_session -f "$session_file" -f "$dev_file" | jq -S "$strip_images")" ]; then
    echo 'compose.dev.yaml may change only build, image and pull_policy.' >&2
    exit 1
fi

# Optional agent tokens are literal and reach only the agents. Explicit
# sandbox settings still win over conflicting entries in agent.env. Compose
# escapes dollar signs in config output so the result can be loaded again.
mkdir -p "$check_dir/src/project/.sandbox"
cat > "$check_dir/src/project/.sandbox/agent.env" <<'EOF'
SANDBOX_CHECK_TOKEN=literal-$TOKEN-${UNSET_TOKEN}-#suffix
HTTPS_PROXY=http://invalid.example
SANDBOX_SESSION=0
EOF
render_session -f "$session_file" | jq -e '
    all(.services | to_entries[];
        if (.key == "claude" or .key == "codex") then
            .value.environment.SANDBOX_CHECK_TOKEN == "literal-$$TOKEN-$${UNSET_TOKEN}-#suffix" and
            .value.environment.HTTPS_PROXY == "http://egress-proxy:3128" and
            .value.environment.SANDBOX_SESSION == "1"
        else
            (.value.environment | has("SANDBOX_CHECK_TOKEN") | not)
        end)
' >/dev/null

"$root_dir/image/sandbox-policy" check base "$root_dir/squid/base-policy.yaml"

# Plugin manifests hold only selectors and GitHub marketplaces.
selector='[A-Za-z0-9._-]+@[A-Za-z0-9._-]+'
if grep -EHnv "^($selector|marketplace [A-Za-z0-9._-]+/[A-Za-z0-9._-]+|#.*|)\$" \
    "$root_dir/codex/plugins.txt" "$root_dir/claude/plugins.txt" >&2; then
    echo 'Invalid plugin manifest entry.' >&2
    exit 1
fi

grep -Fxq 'http_access deny all' "$root_dir/squid/squid.conf"
for script in "$root_dir"/../install.sh "$root_dir"/bin/* "$root_dir"/image/sandbox-* "$root_dir"/image/init.d/* \
    "$root_dir"/claude/agent "$root_dir"/claude/auth "$root_dir"/claude/init.d/* \
    "$root_dir"/codex/agent "$root_dir"/codex/auth "$root_dir"/codex/init.d/*; do
    sh -n "$script"
done

echo 'Sandbox configuration check passed.'
