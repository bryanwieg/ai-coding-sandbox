#!/bin/sh
# Keep a writable Git clone of the plugin repository stored with
# sandbox-dev-plugins in the state volume; the agent launcher loads its
# plugins from there, so edits apply in place and are pushed deliberately.
# A clean clone is fast-forwarded from GitHub. Local changes, unpushed commits,
# and sync failures leave it untouched and never stop the launch.
set -eu

repository=$(sed -n '1p' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sandbox/dev-plugin-repo" 2>/dev/null || :)
[ -n "$repository" ] || exit 0

if ! printf '%s\n' "$repository" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$'; then
    echo "Ignoring the development plugin repository; use owner/repository: $repository" >&2
    exit 0
fi

state_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
clone_dir="$state_dir/dev-plugins/$repository"

if [ ! -e "$clone_dir/.git" ]; then
    printf 'Cloning plugin repository %s...\n' "$repository" >&2
    mkdir -p "${clone_dir%/*}"
    if ! git clone --quiet "https://github.com/$repository.git" "$clone_dir"; then
        rm -rf "$clone_dir"
        echo 'Unable to clone the plugin repository; it will be retried next launch.' >&2
    fi
    exit 0
fi

if ! git -C "$clone_dir" fetch --quiet origin; then
    echo 'Unable to fetch the plugin repository; using the existing clone.' >&2
    exit 0
fi
if [ -n "$(git -C "$clone_dir" status --porcelain)" ]; then
    echo "Plugin repository has local changes; not updating $clone_dir." >&2
    exit 0
fi
if ! git -C "$clone_dir" rev-parse --verify --quiet '@{upstream}' >/dev/null; then
    echo "Plugin repository branch has no upstream; not updating $clone_dir." >&2
    exit 0
fi
if git -C "$clone_dir" merge-base --is-ancestor '@{upstream}' HEAD; then
    if [ "$(git -C "$clone_dir" rev-parse HEAD)" != "$(git -C "$clone_dir" rev-parse '@{upstream}')" ]; then
        echo "Plugin repository has unpushed commits in $clone_dir." >&2
    fi
elif git -C "$clone_dir" merge-base --is-ancestor HEAD '@{upstream}'; then
    git -C "$clone_dir" merge --quiet --ff-only '@{upstream}' ||
        echo 'Unable to fast-forward the plugin repository.' >&2
else
    echo "Plugin repository has diverged from its upstream; not updating $clone_dir." >&2
fi
