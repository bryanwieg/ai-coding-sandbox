#!/bin/sh
set -eu

# Sessions (SANDBOX_SESSION=1) get the sandbox's guide and rules, from the
# image, on every launch.
if [ "${SANDBOX_SESSION:-}" = 1 ]; then
    set -- --append-system-prompt-file /usr/local/share/sandbox/session-instructions.md "$@"
fi

exec claude --dangerously-skip-permissions "$@"
