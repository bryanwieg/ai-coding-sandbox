#!/bin/sh
# At session exit, delete the project's local branches whose work is already
# in the default branch: merged, rebased or squashed into it. Never the
# default branch, the checked-out branch, a branch checked out in any
# worktree, or a branch still at the default branch's tip (likely just
# created). Each deletion prints the commit to restore it from. A quick
# fetch first prunes deleted remote branches and brings the default branch
# up to date; offline, the local refs are used. SANDBOX_EXIT_CLEANUP=off
# skips this.
set -eu

[ "${SANDBOX_SESSION:-}" = 1 ] || exit 0
[ "${SANDBOX_EXIT_CLEANUP:-}" != off ] || exit 0
[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = true ] || exit 0

if git remote get-url origin >/dev/null 2>&1; then
    timeout 20 git fetch --quiet --prune origin >/dev/null 2>&1 || :
fi
git worktree prune 2>/dev/null || :

# The default branch: origin's HEAD, else a local main or master.
default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || :)
default=${default#origin/}
if [ -z "$default" ]; then
    for name in main master; do
        if git show-ref --verify --quiet "refs/heads/$name"; then default=$name; break; fi
    done
fi
[ -n "$default" ] || exit 0

bases=
for ref in "refs/remotes/origin/$default" "refs/heads/$default"; do
    if git show-ref --verify --quiet "$ref"; then bases="$bases $ref"; fi
done
[ -n "$bases" ] || exit 0

in_use=$(git worktree list --porcelain | sed -n 's|^branch refs/heads/||p')

# landed BRANCH BASE: every change on BRANCH is in BASE.
landed() {
    # Merged, or the branch's commits were rebased onto BASE one by one.
    git merge-base --is-ancestor "$1" "$2" && return 0
    if ! git cherry "$2" "$1" | grep -q '^+'; then return 0; fi
    # Squashed: one commit in BASE carries the branch's whole change.
    fork=$(git merge-base "$2" "$1") || return 1
    # A throwaway commit, compared by patch only; a fixed identity keeps it
    # working where none is configured.
    squash=$(GIT_AUTHOR_NAME=sandbox GIT_AUTHOR_EMAIL=sandbox@localhost \
        GIT_COMMITTER_NAME=sandbox GIT_COMMITTER_EMAIL=sandbox@localhost \
        git commit-tree "$1^{tree}" -p "$fork" -m squash) || return 1
    git cherry "$2" "$squash" | grep -q '^-'
}

git for-each-ref --format='%(refname:short)' refs/heads | while IFS= read -r branch; do
    [ "$branch" != "$default" ] || continue
    if printf '%s\n' "$in_use" | grep -Fxq -- "$branch"; then continue; fi
    tip=$(git rev-parse "refs/heads/$branch")
    for base in $bases; do
        [ "$tip" != "$(git rev-parse "$base")" ] || continue 2
    done
    for base in $bases; do
        if landed "refs/heads/$branch" "$base" 2>/dev/null; then
            git branch --quiet -D -- "$branch"
            printf 'Deleted merged branch %s (was %s; restore: git branch %s %s)\n' \
                "$branch" "$(git rev-parse --short "$tip")" "$branch" "$tip"
            break
        fi
    done
done
