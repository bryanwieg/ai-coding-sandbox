#!/bin/sh
# Set up the command's runtime identity and join the lifecycle broker in sessions.
set -eu

runtime_uid=$(id -u)
runtime_gid=$(id -g)
user_name=agent
# SANDBOX_AGENT names the launched agent; sessions always set it. Both
# agents share one XDG config folder, in Claude's state volume where it has
# always been, since the rest of HOME is read-only: plugin settings (such as
# Ponytail's config.json and Band ledgers) and tool config (go env, Composer,
# Git, pip, Ruff) are the same whichever agent runs. An explicit
# XDG_CONFIG_HOME is kept.
case "${SANDBOX_AGENT:-}" in
    claude|codex)
        XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/xdg}
        export XDG_CONFIG_HOME
        ;;
    '') ;;
    *) echo "Unsupported sandbox agent: $SANDBOX_AGENT" >&2; exit 1 ;;
esac
identity_dir=$(mktemp -d "/tmp/$user_name-identity.XXXXXX")

# NSS records supply names; numeric process credentials and permissions stay unchanged.
(
    umask 077
    awk -F: -v uid="$runtime_uid" -v name="$user_name" '$1 != name && $3 != uid' /etc/passwd > "$identity_dir/passwd"
    printf '%s:x:%s:%s:Sandbox agent:/home/%s:/bin/bash\n' "$user_name" "$runtime_uid" "$runtime_gid" "$user_name" >> "$identity_dir/passwd"
    awk -F: -v gid="$runtime_gid" -v name="$user_name" '$1 != name && $3 != gid' /etc/group > "$identity_dir/group"
    printf '%s:x:%s:\n' "$user_name" "$runtime_gid" >> "$identity_dir/group"
)

NSS_WRAPPER_PASSWD="$identity_dir/passwd"
NSS_WRAPPER_GROUP="$identity_dir/group"
LD_PRELOAD="/usr/local/lib/libnss_wrapper.so${LD_PRELOAD:+:$LD_PRELOAD}"
export NSS_WRAPPER_PASSWD NSS_WRAPPER_GROUP LD_PRELOAD

if [ "${SANDBOX_SESSION:-}" = 1 ]; then
    # Compose sets the Docker variables even when the daemon profile is off.
    if [ -n "${DOCKER_HOST:-}" ] && ! timeout 2 getent hosts docker >/dev/null 2>&1; then
        unset DOCKER_HOST DOCKER_TLS_VERIFY DOCKER_CERT_PATH SANDBOX_DOCKER_SOCKET
    fi
    exec sandbox-lifecycle run "${SANDBOX_AGENT:-}" -- "$@"
fi
exec "$@"
