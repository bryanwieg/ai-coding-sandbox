#!/bin/sh
# The project's .ai-scratchpad/ holds the agents' working notes and scratch
# files across sessions. Create it, keep it out of Git with its own
# .gitignore (the project's .gitignore and .git stay untouched), and delete
# entries untouched for the project's last SANDBOX_SCRATCHPAD_DAYS session
# days (default 7; "off" keeps everything). Age counts only days on which a
# session started, recorded in .session-days, so time away from the project
# does not age its notes. Only sessions do this.
set -eu

[ "${SANDBOX_SESSION:-}" = 1 ] || exit 0
[ -w "$PWD" ] || exit 0

scratch=$PWD/.ai-scratchpad
days=${SANDBOX_SCRATCHPAD_DAYS:-7}

case "$days" in
    off) ;;
    '' | *[!0-9]* | 0)
        printf 'Warning: SANDBOX_SCRATCHPAD_DAYS must be a number of session days or off, not %s; keeping .ai-scratchpad as it is.\n' \
            "$days" >&2
        days=off
        ;;
esac

# A link could point outside the project; never create or clean through one.
for path in "$scratch" "$scratch/.gitignore" "$scratch/.session-days"; do
    if [ -L "$path" ] || { [ "$path" = "$scratch" ] && [ -e "$path" ] && [ ! -d "$path" ]; }; then
        printf 'Warning: .ai-scratchpad or its bookkeeping is a link or not a plain folder; leaving it alone.\n' >&2
        exit 0
    fi
done
mkdir -p "$scratch"
[ -e "$scratch/.gitignore" ] || printf '*\n' > "$scratch/.gitignore"

# Record today as a session day, keeping the most recent ones.
log=$scratch/.session-days
today=$(date +%F)
[ -f "$log" ] || : > "$log"
if [ "$(tail -n 1 "$log")" != "$today" ]; then
    printf '%s\n' "$today" >> "$log"
fi
keep=$days
[ "$keep" != off ] || keep=366
tail -n "$keep" "$log" > "$log.new" && mv "$log.new" "$log"

[ "$days" != off ] || exit 0
# Until the project has that many session days, nothing is old enough.
[ "$(wc -l < "$log")" -ge "$days" ] || exit 0
cutoff=$(head -n 1 "$log")
# find does not follow links, so only entries inside the folder are removed.
find "$scratch" -mindepth 1 ! -type d ! -path "$scratch/.gitignore" ! -path "$scratch/.session-days" \
    ! -newermt "$cutoff" -delete 2>/dev/null || :
find "$scratch" -mindepth 1 -type d -empty -delete 2>/dev/null || :
