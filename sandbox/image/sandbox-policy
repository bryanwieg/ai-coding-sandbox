#!/bin/sh
# Egress policy helper shared by the session proxy, its trust command, and
# the agent's startup warning.
#
#   sandbox-policy check base|project FILE
#       Validates FILE. Sections: https (CONNECT, default port 443), http
#       (plain HTTP, default port 80) and ssh (CONNECT, default port 22) hold
#       "  - NAME" or "  - NAME:PORT" lines.
#       A project policy may also have hosts with "  NAME: ADDRESS"
#       pins, and a top-level "unrestricted_out: true", which allows every
#       destination through the proxy ("unrestricted" is its older name and
#       approves identically). A base policy must allow at least one
#       HTTPS name.
#   sandbox-policy additions FILE
#       Prints the effective entries of a valid FILE, one "SECTION NAME",
#       "hosts NAME ADDRESS" or "unrestricted all-destinations" line each,
#       sorted and without duplicates.
#       Comments and layout do not change the output.
#   sandbox-policy hash FILE
#       Prints the SHA-256 of those entries, or nothing when there are none.
#   sandbox-policy trust-id PATH
#       Prints the trust store key for a project folder.
set -eu

usage() {
    echo 'Usage: sandbox-policy check base|project FILE | additions FILE | hash FILE | trust-id PATH' >&2
    exit 2
}

entries() {
    awk -v mode="$1" '
        function fail(message) {
            printf "%s:%d: %s\n", FILENAME, FNR, message > "/dev/stderr"
            invalid = 1
        }
        function valid_ipv4(address,    parts, count, i) {
            count = split(address, parts, ".")
            if (count != 4) return 0
            for (i = 1; i <= 4; i++)
                if (parts[i] !~ /^(0|[1-9][0-9]?[0-9]?)$/ || parts[i] + 0 > 255) return 0
            return 1
        }
        BEGIN { default_port["https"] = 443; default_port["http"] = 80; default_port["ssh"] = 22 }
        /^[[:space:]]*($|#)/ { next }
        /^(https|http|ssh|hosts):[[:space:]]*$/ {
            section = $1
            sub(/:$/, "", section)
            if (section == "hosts" && mode != "project") fail("hosts pins belong in a project policy")
            next
        }
        /^unrestricted(_out)?:[[:space:]]*(true|false)[[:space:]]*$/ {
            section = ""
            if (mode != "project") { fail("unrestricted_out belongs in a project policy"); next }
            if ($2 == "true") print "unrestricted all-destinations"
            next
        }
        /^http_8888:[[:space:]]*$/ {
            fail("http_8888 is retired; list its names under http as NAME:8888")
            section = "retired"
            next
        }
        section == "retired" && /^  - / { next }
        section != "hosts" && /^  - [.A-Za-z0-9-]+(:[0-9]+)?[[:space:]]*$/ {
            if (section == "") { fail("entry outside a section"); next }
            count = split($2, endpoint, ":")
            name = tolower(endpoint[1])
            port = count == 2 ? endpoint[2] : default_port[section]
            if (port !~ /^[1-9][0-9]*$/ || length(port) > 5 || port + 0 > 65535) {
                fail("invalid " section " port: " port)
                next
            }
            # Bare names and their explicit default port are the same entry,
            # so existing approvals of bare names are preserved.
            print section " " name (port == default_port[section] ? "" : ":" port)
            if (section == "https") https++
            next
        }
        section == "hosts" && /^  [A-Za-z0-9][.A-Za-z0-9-]*:[[:space:]]+[0-9.]+[[:space:]]*$/ {
            name = $1
            sub(/:$/, "", name)
            if (!valid_ipv4($2)) { fail("invalid IPv4 address: " $2); next }
            print "hosts " tolower(name) " " $2
            next
        }
        { fail("unrecognized line: " $0) }
        END {
            if (mode == "base" && !https) fail("a base policy must allow at least one https name")
            if (invalid) exit 1
        }
    ' "$2"
}

[ "$#" -ge 2 ] || usage
case "$1" in
    check)
        [ "$#" -eq 3 ] || usage
        case "$2" in base|project) ;; *) usage ;; esac
        entries "$2" "$3" >/dev/null
        ;;
    additions)
        [ "$#" -eq 2 ] || usage
        list=$(entries project "$2")
        [ -z "$list" ] || printf '%s\n' "$list" | LC_ALL=C sort -u
        ;;
    hash)
        [ "$#" -eq 2 ] || usage
        list=$("$0" additions "$2")
        [ -z "$list" ] || printf '%s\n' "$list" | sha256sum | cut -d ' ' -f 1
        ;;
    trust-id)
        [ "$#" -eq 2 ] || usage
        printf '%s' "$2" | sha256sum | cut -d ' ' -f 1
        ;;
    *) usage ;;
esac
