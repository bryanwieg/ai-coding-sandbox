#!/bin/sh
# Session proxy entrypoint. sandbox-proxy-config renders the configuration
# from the base policy and the project's approved additions, and the host's
# sandbox command reloads it in place with sandbox-proxy-config --reload when
# the approved policy changes.
# The image entrypoint runs this script under the lifecycle broker so Squid
# stops with the session group.
set -eu

sandbox-proxy-config
exec squid -N -f /tmp/squid.conf
