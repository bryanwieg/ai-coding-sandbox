#!/bin/sh
# Print the version of one of the image's agent CLIs:
#   sandbox-agent-version AGENT            the version installed in this image
#   sandbox-agent-version AGENT --latest   the latest release on the npm registry
# AGENT is claude or codex. --latest needs a network; run it outside the
# sandbox.
set -eu

usage() {
    echo 'Usage: sandbox-agent-version claude|codex [--latest]' >&2
    exit 2
}

case "${1:-}" in
    claude) package=@anthropic-ai/claude-code ;;
    codex) package=@openai/codex ;;
    *) usage ;;
esac
case "${2:-}" in
    '') exec node -p "require('/opt/$1/node_modules/$package/package.json').version" ;;
    --latest) exec npm view --cache /tmp/npm-cache --update-notifier=false "$package" version ;;
    *) usage ;;
esac
