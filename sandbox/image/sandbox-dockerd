#!/bin/sh
# Runs the rootless session daemon under the lifecycle broker. Validate the
# runtime identity and retention setting before touching the data root.
# Wipe ephemeral data on startup and after the daemon exits.
set -eu

data=$XDG_DATA_HOME/docker
retention=${SANDBOX_DOCKER_DATA:-ephemeral}

# Every supported UID has a fixed "sandbox" entry whose group equals the UID;
# newuidmap and newgidmap accept only that identity.
if [ "$(id -un 2>/dev/null)" != sandbox ]; then
    echo "sandbox-dockerd: UID $(id -u) is not supported; use a UID from 500 to 65533." >&2
    exit 1
fi
case $retention in
    ephemeral | persistent) ;;
    *)
        echo "sandbox-dockerd: SANDBOX_DOCKER_DATA must be ephemeral or persistent; got '$retention'." >&2
        exit 1
        ;;
esac
if [ "$(id -g)" != "$(id -u)" ]; then
    echo "sandbox-dockerd: run with group $(id -u), equal to the UID; got group $(id -g)." >&2
    exit 1
fi
if [ -n "${SANDBOX_GID:-}" ] && [ "$SANDBOX_GID" != "$(id -g)" ]; then
    echo "sandbox-dockerd: your group $SANDBOX_GID differs from your UID; files that containers create get group $(id -g)." >&2
fi

# Files under the data root belong to subordinate IDs, so only the user
# namespace that owns them can remove them. Persistent data is kept.
wipe() {
    [ "$retention" = ephemeral ] || return 0
    [ ! -e "$data" ] || rootlesskit rm -rf "$data"
}

# Only the default command takes added daemon flags; see dockerd-entrypoint.sh.
# It also listens on /run/docker.sock (/var/run/docker.sock), a path only the
# daemon's own mount namespace sees, so a container bind-mounts it with
# "-v /var/run/docker.sock:/var/run/docker.sock" to manage this same daemon.
# That grants what the agent already has over TLS and nothing more.
if [ "$#" -eq 0 ] || [ "${1#-}" != "$1" ]; then
    if [ "$retention" = ephemeral ]; then
        set -- --shutdown-timeout="${SANDBOX_DOCKER_STOP_TIMEOUT:-2}" "$@"
    fi
    set -- --host=unix:///run/docker.sock "$@"
fi

wipe
dockerd-entrypoint.sh "$@" &
daemon=$!
trap 'kill -TERM "$daemon" 2>/dev/null || :' TERM INT

# A trapped signal interrupts wait; collect the daemon's status before wiping.
while :; do
    status=0
    wait "$daemon" || status=$?
    kill -0 "$daemon" 2>/dev/null || break
done
wipe
exit "$status"
