#!/bin/sh
# Default command of the agent image: run the shared initialization, then the
# launched agent's (SANDBOX_AGENT), then the other agent's, each in name
# order, and hand off to the launched agent's launcher. The other agent is set
# up too because the launched one may run it; its scripts stay quiet and skip
# plugin synchronization until it is signed in. Command overrides (a shell,
# an auth command) bypass this script entirely.
set -eu

libexec_dir=/usr/local/libexec/sandbox
agent=${SANDBOX_AGENT:-}
case "$agent" in
    claude) other=codex ;;
    codex) other=claude ;;
    *) echo 'Set SANDBOX_AGENT to claude or codex.' >&2; exit 2 ;;
esac

for script in "$libexec_dir"/init.d/* "$libexec_dir/$agent"/init.d/* "$libexec_dir/$other"/init.d/*; do
    [ -x "$script" ] || continue
    "$script"
done

exec "$libexec_dir/$agent/agent" "$@"
