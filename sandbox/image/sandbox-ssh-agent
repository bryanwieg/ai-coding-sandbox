#!/bin/sh
# Serve an empty ssh-agent for sandbox-ssh-unlock. Keys expire after their
# lifetime, and the lifecycle broker stops the sidecar with the session group.
# A requested stop exits 0 even though ssh-agent itself exits 2 on SIGTERM.
set -eu

socket=/run/ssh-agent/agent.sock
lifetime=${SANDBOX_SSH_KEY_LIFETIME:-8h}

rm -f "$socket"
ssh-agent -D -a "$socket" -t "$lifetime" >/dev/null &
agent=$!
stopping=false
trap 'stopping=true; kill -TERM "$agent" 2>/dev/null || :' TERM INT

# A trapped signal interrupts wait before ssh-agent finishes exiting.
while :; do
    status=0
    wait "$agent" || status=$?
    kill -0 "$agent" 2>/dev/null || break
done
rm -f "$socket"
if [ "$stopping" = true ]; then
    exit 0
fi
exit "$status"
